// ───────────────────────────────────────────────────────────────
// Prisma schema — UTM / link tracker
// Core idea: ClickEvent gets a unique clickId, which is forwarded to
// Tilda. When Tilda fires the webhook, the incoming clickId lets us
// attach the Lead to the exact ClickEvent (exact attribution).
// ───────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AttributionStatus {
  exact // matched via click_id
  estimated // matched via utm + time window heuristic
  unknown // no match found
}

enum WebhookStatus {
  success
  failed
  missing_click_id
  duplicated
  unauthorized
}

enum UserRole {
  admin // everything, incl. users and settings
  manager // project manager: edits own project folders, sees the rest
  viewer // sees everything, edits nothing
}

enum UserStatus {
  pending // registered, waiting for an admin
  active
  disabled
  declined // sign-up turned down; kept so admins see who was declined
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?
  role         UserRole   @default(viewer)
  status       UserStatus @default(pending)
  position     String? // e.g. "Project manager", "VP"
  projectKeys  String[]   @default([]) // project folders a manager edits (see projectGroups.ts)
  lastLoginAt  DateTime?
  about        String? // what they wrote at sign-up: team, role
  signup       Json? // where they signed up from: city, country, device, browser, os, language, referrer
  decidedAt    DateTime? // when an admin approved or declined the sign-up
  decidedBy    String? // that admin's name or e-mail
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  campaigns Campaign[]
  links     TrackingLink[]
}

model Campaign {
  id          String   @id @default(cuid())
  userId      String?
  name        String // utm_campaign value, e.g. "icy_s26"
  label       String? // human label, e.g. "ICY S'26"
  description String?
  funnel      String? // e.g. "Projects"
  season      String? // e.g. "spring 2026"
  type        String? // e.g. "Event"
  slugPrefix  String? @unique // short project code for generated link slugs, e.g. "tts"
  status      String   @default("active") // active | paused | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User?          @relation(fields: [userId], references: [id])
  links TrackingLink[]

  @@index([userId])
}

model TrackingLink {
  id             String   @id @default(cuid())
  userId         String?
  campaignId     String?
  name           String // description for the team
  slug           String   @unique // short id used in /r/{slug}
  shortDomain    String? // domain the short link is handed out with, e.g. "zimran-aiesec.vercel.app"; null = the main one (every domain opens every slug)
  destinationUrl String
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  customParams   Json? // { key: value }
  tags           String[] @default([])
  notes          String?
  isActive       Boolean  @default(true)
  isArchived     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?        @relation(fields: [userId], references: [id])
  campaign Campaign?    @relation(fields: [campaignId], references: [id])
  clicks   ClickEvent[]
  leads    Lead[]

  @@index([userId])
  @@index([campaignId])
  @@index([slug])
}

model ClickEvent {
  id             String   @id @default(cuid())
  trackingLinkId String
  clickId        String   @unique // forwarded to Tilda, used for exact attribution
  timestamp      DateTime @default(now())

  userAgent String?
  ipHash    String? // hashed, never the raw IP
  referrer  String?
  country   String?
  city      String?
  device    String? // mobile | desktop | tablet
  browser   String?
  os        String?

  isUnique  Boolean @default(true) // first click from this ipHash on this link
  rawParams Json? // full query string captured at click time

  trackingLink TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@index([trackingLinkId])
  @@index([clickId])
  @@index([timestamp])
  @@index([ipHash])
}

model Lead {
  id             String  @id @default(cuid())
  trackingLinkId String?
  clickEventId   String?
  clickId        String?

  name     String?
  phone    String?
  email    String?
  formName String?
  pageUrl  String?

  // UTM as actually received from Tilda (may differ / be missing)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  submittedAt       DateTime
  sourcePayload     Json // full raw webhook body
  attributionStatus AttributionStatus @default(unknown)
  dedupeKey         String            @unique // prevents duplicate leads

  createdAt DateTime @default(now())

  trackingLink TrackingLink? @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)
  clickEvent   ClickEvent?   @relation(fields: [clickEventId], references: [id], onDelete: SetNull)

  @@index([trackingLinkId])
  @@index([clickEventId])
  @@index([clickId])
  @@index([submittedAt])
}

model WebhookLog {
  id        String        @id @default(cuid())
  provider  String        @default("tilda")
  payload   Json
  status    WebhookStatus
  message   String?
  leadId    String?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([status])
}

// ─── Reports: parsed Excel analyses (Feedback / Registration) ───────────
// Only the normalised, sanitised JSON is stored — never the uploaded file.

enum ReportStatus {
  draft
  published
}

enum ReportVisibility {
  private // signed-in admins only
  link // anyone with the link (noindex)
  public // anyone; may be indexed
}

model Report {
  id             String           @id @default(cuid())
  slug           String           @unique
  type           String // feedback | registration
  title          String
  eventName      String?
  status         ReportStatus     @default(draft)
  visibility     ReportVisibility @default(link)
  createdBy      String?
  sourceFileName String?
  parserVersion  String
  data           Json // ReportDocument
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  publishedAt    DateTime?
  projectId      String?

  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  themeMappings ThemeMapping[]

  @@index([status])
  @@index([createdAt])
  @@index([projectId])
}

// ─── Projects: events the reports belong to, filtered on /projects ──────

model ProjectType {
  id        String    @id @default(cuid())
  key       String    @unique // stable key used in URLs and filter `appliesTo`
  name      String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  projects  Project[]
}

enum ProjectStatus {
  planned
  registration
  done
  archived
}

enum ProjectFormat {
  offline
  online
  hybrid
}

model Project {
  id        String         @id @default(cuid())
  slug      String         @unique
  name      String
  typeId    String
  format    ProjectFormat?
  status    ProjectStatus  @default(planned)
  startDate DateTime?
  endDate   DateTime?
  city      String?
  venue     String?
  ownerTeam String?
  tags      String[]       @default([])
  demo      Boolean        @default(false) // created by the demo seed
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  type    ProjectType     @relation(fields: [typeId], references: [id])
  reports Report[]
  metrics ProjectMetrics?

  @@index([typeId])
  @@index([status])
  @@index([startDate])
}

// Denormalised numbers taken from the project's reports, recomputed whenever a
// report changes. Every field is nullable: missing data is null, never 0.
// Scores are stored on a /10 scale.
model ProjectMetrics {
  projectId String @id

  // scale
  registrants  Int?
  submissions  Int?
  campaignDays Int?
  channelCount Int?
  responses    Int?
  responseRate Float?

  // results (feedback)
  orgScore10           Float?
  nps                  Float?
  composite10          Float?
  weakestZone          String? // zone key, see src/lib/projects/zones.ts
  weakestZoneScore10   Float?
  strongestZone        String?
  strongestZoneScore10 Float?
  topPraiseTheme       String? // canonical theme key
  topPainTheme         String?

  // acquisition & audience (registration)
  topChannelGroup    String? // channel group key
  topChannelShare    Float?
  topChannel         String? // channel name as in the report
  topChannelOwnShare Float?
  hhiGroups          Float?
  concentrationLevel String? // low | moderate | high
  peakDayShare       Float?
  isBursty           Boolean?
  topUniversityName  String?
  topUniversityShare Float?
  newToOrgShare      Float?
  internshipShare    Float?
  avgAge             Float?
  duplicateRate      Float?
  audienceStage      String? // y1_2 | y3_4 | grad | pre_uni
  ageBand            String? // most common age band label, e.g. "18–19"

  // service
  hasRegistrationReport Boolean   @default(false)
  hasFeedbackReport     Boolean   @default(false)
  hasWarnings           Boolean   @default(false)
  reportVisibilities    String[]  @default([])
  reportsUpdatedAt      DateTime?
  metricsVersion        Int
  computedAt            DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([registrants])
  @@index([orgScore10])
  @@index([weakestZone])
  @@index([topChannelGroup])
  @@index([concentrationLevel])
}

// Open-answer theme of a report → shared theme dictionary, so themes can be
// compared across projects. Auto-suggested on upload, confirmed by an admin.
model ThemeMapping {
  id        String  @id @default(cuid())
  reportId  String
  kind      String // praise | pain | request
  rawLabel  String
  canonical String? // theme key, null = not mapped (ignored by filters)
  confirmed Boolean @default(false)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, kind, rawLabel])
}

// Tunable thresholds (sample size, "needs attention"...), editable without a deploy.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// A named set of project filters + sort.
model SavedView {
  id        String   @id @default(cuid())
  name      String
  query     String // URL query string, e.g. "type=forum&score10=9..10&sort=-date"
  createdAt DateTime @default(now())
}

// ─── Registration-form analytics (drop-off funnel, Tally-style) ───────────────
// Filled by POST /api/collect from the landing's analytics script. Anonymous:
// text answers (name, e-mail, phone, telegram, age) are never stored, only
// whether a field was filled, its length and validity. Category answers
// (city, status, relocation, checkboxes) are kept for slicing.

/// One form on a landing; field order comes from the page (first session that reports it).
model AnalyticsForm {
  id          String   @id // e.g. "tts-f26-registration"
  projectSlug String? // project folder key in Campaigns → Projects, e.g. "toptalentssprint-f26"
  projectSetByHand Boolean @default(false) // picked in Forms: the page's links / UTM no longer change it
  title       String? // heading of the form's block (forms found by /t.js), else the page title
  customTitle String? // the team's own name for the form; shown instead of title
  pageUrl     String? // page the form is on (forms found by /t.js)
  fields      Json // [{k, kind: text|select|check, cond: bool, req: bool, label?}] in page order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions AnalyticsSession[]
}

enum AnalyticsOutcome {
  open // still on the page or left before the page could report it
  success // the form was sent
  abandoned // left the page without sending
}

model AnalyticsSession {
  id          String  @id // client session_id (new after 30 min of inactivity)
  visitorId   String
  formId      String
  projectSlug String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String? // = Campaign.name in the tracker
  utmContent  String?
  utmTerm     String?
  clickId     String? // tracker click (ClickEvent.clickId) when the visitor came through a tracker link
  referrer    String?
  landingUrl  String?
  device      String? // mobile | tablet | desktop
  screenW     Int?
  lang        String?
  country     String? // from Vercel's geo header
  ipHash      String? // sha256(ip + daily salt): no raw IP is stored

  answers     Json? // latest category answers, e.g. {"city":"almaty","relocation":"yes"}
  startedAt   DateTime
  lastSeenAt  DateTime
  outcome     AnalyticsOutcome @default(open)
  lastField   String? // last active field when the page was left
  isTest      Boolean          @default(false)

  form   AnalyticsForm    @relation(fields: [formId], references: [id], onDelete: Cascade)
  events AnalyticsEvent[]

  @@index([formId, startedAt])
  @@index([visitorId])
  @@index([utmCampaign])
}

model AnalyticsEvent {
  id        String   @id // client event id "<session>.<n>": a resent batch is not stored twice
  sessionId String
  type      String // page_view, form_start, field_blur, submit_success, …
  fieldId   String?
  ts        DateTime
  offsetMs  Int // ms since the session started
  meta      Json?

  session AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, ts])
  @@index([type, fieldId])
  @@index([ts])
}

// Sign-in / sign-up attempts per visitor (hashed IP), for rate limiting.
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String // "login" | "register"
  ipHash    String
  ok        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([kind, ipHash, createdAt])
}
