{
  "name": "utm-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready UTM / link tracker with click \u2192 Tilda \u2192 webhook \u2192 lead attribution",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && node scripts/migrate-production.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "parse:report": "tsx scripts/parse-report.ts",
    "test": "vitest run",
    "sanitize:fixture": "tsx scripts/sanitize-fixture.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "projects:recompute": "tsx scripts/recompute-metrics.ts",
    "analytics:purge": "node scripts/purge-analytics.mjs",
    "check:forms": "tsx scripts/check-form-autodiscovery.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "jszip": "3.10.1",
    "next": "15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.4",
    "saxes": "5.0.1",
    "ua-parser-js": "^1.0.39",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "2.1.9"
  }
}
