# ─────────────────────────────────────────────────────────────
# DATABASE  (PostgreSQL — e.g. Vercel Postgres / Neon / Supabase)
# ─────────────────────────────────────────────────────────────
# Pooled connection string used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────
# Public base URL of THIS tracker (used to build /r/{slug} links).
# No trailing slash.
NEXT_PUBLIC_BASE_URL="https://your-tracker.vercel.app"

# Secret that Tilda must send with every webhook call.
# Tilda sends it either as header  X-Webhook-Secret: <value>
# or as query param  ?secret=<value>
WEBHOOK_SECRET="change-me-to-a-long-random-string"

# Salt used to hash visitor IPs (we never store raw IPs).
IP_HASH_SALT="change-me-too"

# ─────────────────────────────────────────────────────────────
# ADMIN LOGIN
# ─────────────────────────────────────────────────────────────
# Credentials for the dashboard login page.
AUTH_EMAIL="you@example.com"
AUTH_PASSWORD="change-me-to-a-strong-password"
# Signs session cookies. Required, 16+ characters (e.g. `openssl rand -hex 32`).
AUTH_SECRET="change-me-to-a-long-random-string"

# ─────────────────────────────────────────────────────────────
# GOOGLE SHEETS (optional) — read project registration sheets
# ─────────────────────────────────────────────────────────────
# Whole JSON key of a Google Cloud service account with the Sheets API on.
# Share each registration sheet with its client_email as a viewer.
# See docs/conversions.md. Without it, upload the sheet as CSV/XLSX instead.
GOOGLE_SERVICE_ACCOUNT_JSON=""
